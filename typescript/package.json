{
  "name": "@beeos-ai/bma-sdk",
  "version": "0.3.0",
  "description": "TypeScript client for the BMA REST API and the BMA extensions to the Anthropic Managed Agents API.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeos-ai/bma-sdks.git",
    "directory": "typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./facade-extensions": {
      "types": "./dist/facade-extensions.d.ts",
      "import": "./dist/facade-extensions.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "openapi-typescript ../contracts/bma/rest.openapi.yaml -o src/generated/rest.ts && openapi-typescript ../contracts/bma/facade-extensions.openapi.yaml -o src/generated/facade-extensions.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
