{
  "name": "@beeos-ai/bma-executor-sdk",
  "version": "0.4.8",
  "description": "BMA executor protocol (bma.executor.v1.1): executor, harness and agent ends with WebSocket, local socket and in-process transports.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beeos-ai/bma-sdks.git",
    "directory": "executor/typescript"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/*.test.js"
  },
  "dependencies": {
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
